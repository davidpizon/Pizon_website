<?xml version="1.0" encoding="utf-8"?>
<!--
  coverlet.collector settings used by every test project (see ../coverage.ps1).
  Exclusions are kept minimal: generated code, EF Core migrations and the Aspire AppHost
  wiring (covered by the AppHost smoke test instead). Anything else needs a written reason.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Pizon.*]*</Include>
          <Exclude>[Pizon.AppHost]*,[Pizon.*.Tests]*,[Pizon.Doors.TemplateDoor]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**,**/Migrations/*.cs</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
