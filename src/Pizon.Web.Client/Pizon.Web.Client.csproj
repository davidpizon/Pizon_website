<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pizon.Doors.Sdk\Pizon.Doors.Sdk.csproj" />
    <!-- The screen compiler: turns Screens/Art/*.dur into C# art classes at build time. -->
    <ProjectReference Include="..\Pizon.Screens.Generator\Pizon.Screens.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Doors are lazy-loaded: referenced here, but only downloaded when a caller enters one. -->
    <ProjectReference Include="..\Pizon.Doors.Oracle\Pizon.Doors.Oracle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="Pizon.Doors.Oracle.wasm" />
    <!-- Door entry types are created by reflection, so keep them from being trimmed. -->
    <TrimmerRootAssembly Include="Pizon.Doors.Oracle" />
  </ItemGroup>

  <ItemGroup>
    <!-- Screen art is compiled into the assembly by the screen compiler and never published as a file. -->
    <AdditionalFiles Include="Screens\Art\*.dur;Screens\Art\*.anim.json" />
    <None Remove="Screens\Art\*.dur;Screens\Art\*.anim.json" />
    <Content Remove="Screens\Art\*.anim.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pizon.Web.Client.Tests" />
  </ItemGroup>

</Project>
