root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,props,targets,csproj,slnx,xml,runsettings,yml,yaml}]
indent_size = 2

[*.{js,mjs}]
indent_size = 2

[*.cs]
# ---- Documentation is mandatory (StyleCop documentation rules are errors) ----
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = error
# File headers are not used in this repo.
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1634.severity = none
dotnet_diagnostic.SA1635.severity = none
dotnet_diagnostic.SA1636.severity = none
dotnet_diagnostic.SA1637.severity = none
dotnet_diagnostic.SA1638.severity = none
dotnet_diagnostic.SA1640.severity = none
dotnet_diagnostic.SA1641.severity = none
# SA1649 (file name must match first type) is a file-naming rule that StyleCop files under
# documentation; small related DTOs share one file (e.g. Api/Contracts.cs), so it is off.
dotnet_diagnostic.SA1649.severity = none

# ---- Other StyleCop categories are off; only documentation is enforced ----
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none

# ---- Code style enforced in build (EnforceCodeStyleInBuild=true) ----
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# EF Core migrations are generated by `dotnet ef`.
[**/Migrations/*.cs]
generated_code = true

# BL0016 (JS interop call not in try/catch): JsTerminal is a thin pass-through to our own bundled
# terminal module. A failing call is handled one level up: BbsApp catches it, prints NO CARRIER and
# redials. Wrapping each pass-through call would only duplicate that boundary.
[Pizon.Web.Client/Terminal/JsTerminal.cs]
dotnet_diagnostic.BL0016.severity = none

# xUnit1051 (pass TestContext.Current.CancellationToken): the tests drive in-memory fakes that complete
# synchronously, so threading the test token through every call would add noise without making a
# cancelled run stop any sooner.
[tests/**.cs]
dotnet_diagnostic.xUnit1051.severity = none
