@page "/bulletins"
@layout BbsLayout
@inherits BbsPage
@attribute [BbsAccess(ScreenAccess.Public)]

<PageTitle>@RouteTable.Tab("System bulletins")</PageTitle>
@if (entries is not null)
{
    <BbsScreen Art="BulletinsArt.Instance">
        <List Slot="BulletinsArt.List" Items="items" />
        <Hotkey Key="Q" Href="/menu" Label="Back to the main menu" />
        <Hotkey Key="@DoorKeys.Escape" Href="/menu" />
        <Hotkey Key="T" Href="/bulletins/top" Label="Top players" />
        @foreach (var entry in entries)
        {
            <Hotkey @key="entry.Key" Key="@entry.Key" Href="@entry.Href" Label="@entry.Label" />
        }
    </BbsScreen>
}
