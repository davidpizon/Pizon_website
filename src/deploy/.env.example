# Copy to ~/pizon/.env on the server and fill in. Never commit the real file.
# Discord application (Developer Portal -> OAuth2); redirect URI https://pizon.com/signin-discord
Discord__ClientId=
Discord__ClientSecret=
# Your own Discord user ID: that account gets SysOp level 255 and the hidden console.
SysOp__DiscordUserId=
# Optional: relay a Discord channel as SYSTEM BULLETINS. The bot of the same Discord application (Bot -> Token),
# invited with View Channel + Read Message History; the channel id comes from Developer Mode -> Copy Channel ID.
Discord__BotToken=
Discord__Feeds__Bulletins__ChannelId=
# Discord__PollMinutes=10
# Push notifications for SysOp pages and posts awaiting review (an ntfy.sh topic URL or a Discord webhook URL).
Notify__WebhookUrl=
# Optional: phosphor glow blur around terminal text, as a fraction of the font size (0 = off, max 1). Default 0.1.
# Terminal__GlowBlur=0.1
